<ui:FluentWindow x:Class="LightsOut.Views.EditTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:LightsOut.Helpers"
        Title="设置时间" Height="520" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TitleText" Text="添加闹钟" FontSize="28" FontWeight="Bold" Margin="0,0,0,24" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        
        <StackPanel Grid.Row="1">
            <!-- Time Picker Card -->
            <ui:Card Padding="24" Margin="0,0,0,16">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[HourLabel]}" Margin="0,0,0,8" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:NumberBox x:Name="HourBox" Minimum="0" Maximum="23" SpinButtonPlacementMode="Compact" Width="120" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="16,28,16,0" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[MinuteLabel]}" Margin="0,0,0,8" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:NumberBox x:Name="MinuteBox" Minimum="0" Maximum="59" SpinButtonPlacementMode="Compact" Width="120" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ui:Card>
            
            <!-- Repeat Card (phone-alarm style) -->
            <ui:Card Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <!-- 摘要行：点击展开/收起星期选择器 -->
                    <Button x:Name="BtnRepeatRow"
                            Click="OnRepeatRowClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            IsTabStop="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Margin="20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[RepeatLabel]}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="RepeatSummaryText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:SymbolIcon x:Name="RepeatChevronIcon"
                                           Grid.Column="2"
                                           Symbol="ChevronRight24"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- 展开后的选择面板 -->
                    <StackPanel x:Name="RepeatPickerPanel" Margin="20,4,20,20" Visibility="Collapsed">
                        <!-- 快捷预设 -->
                        <UniformGrid Rows="1" Columns="3" HorizontalAlignment="Stretch">
                            <UniformGrid.Resources>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="Padding" Value="0,6"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </UniformGrid.Resources>
                            <ToggleButton x:Name="BtnPresetOnce" Click="OnPresetClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[RepeatOnce]}"/>
                            <ToggleButton x:Name="BtnPresetWorkdays" Click="OnPresetClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[RepeatWorkdays]}"/>
                            <ToggleButton x:Name="BtnPresetEveryday" Click="OnPresetClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[RepeatEveryday]}"/>
                        </UniformGrid>

                        <!-- 自定义星期多选 -->
                        <UniformGrid Rows="1" Columns="7" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                            <UniformGrid.Resources>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="Width" Value="36"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="FontSize" Value="14"/>
                                </Style>
                            </UniformGrid.Resources>
                            <ToggleButton x:Name="BtnMon" Click="OnDayButtonClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Day1Short]}"/>
                            <ToggleButton x:Name="BtnTue" Click="OnDayButtonClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Day2Short]}"/>
                            <ToggleButton x:Name="BtnWed" Click="OnDayButtonClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Day3Short]}"/>
                            <ToggleButton x:Name="BtnThu" Click="OnDayButtonClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Day4Short]}"/>
                            <ToggleButton x:Name="BtnFri" Click="OnDayButtonClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Day5Short]}"/>
                            <ToggleButton x:Name="BtnSat" Click="OnDayButtonClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Day6Short]}"/>
                            <ToggleButton x:Name="BtnSun" Click="OnDayButtonClick" Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Day7Short]}"/>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
        
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ui:Button x:Name="BtnCancel" Content="取消" Icon="{ui:SymbolIcon Symbol=Dismiss24}" HorizontalAlignment="Stretch" Padding="0,6" Click="BtnCancel_Click" Grid.Column="0" Grid.Row="0"/>
            <ui:Button Grid.Column="2" Grid.Row="0" Content="确定" Icon="{ui:SymbolIcon Symbol=Checkmark24}" Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,6" Click="BtnOK_Click"/>
            <ui:Button x:Name="BtnDelete" Content="删除" Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Danger" HorizontalAlignment="Stretch" Padding="0,6" Click="BtnDelete_Click" Grid.Row="2" Grid.ColumnSpan="3" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</ui:FluentWindow>