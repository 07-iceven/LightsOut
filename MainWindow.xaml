<Window x:Class="LightsOut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:LightsOut"
        xmlns:vm="clr-namespace:LightsOut.ViewModels"
        xmlns:models="clr-namespace:LightsOut.Models"
        xmlns:helpers="clr-namespace:LightsOut.Helpers"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[AppTitle]}"
        Height="650" Width="420"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,8,0,16">
            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[AppTitle]}" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Master Switch & Countdown -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,10">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[MainToggleLabel]}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,12,0"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsOn="{Binding IsActive}" 
                                     OnContent="{x:Null}" OffContent="{x:Null}" 
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Width="52"
                                     MinWidth="52"
                                     Margin="0"
                                     Padding="0"
                                     FocusVisualStyle="{x:Null}"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="20">
                <TextBlock Text="{Binding CountdownText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Multi-Time List -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" 
                     ItemsSource="{Binding ShutdownTimes}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ShutdownTime}">
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                CornerRadius="8"
                                Padding="16,12">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding DisplayTime}" 
                                           FontSize="22" 
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,0"/>

                                <Button Grid.Column="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Padding="8"
                                        Margin="0,0,10,0"
                                        Command="{Binding DataContext.RemoveTimeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        FocusVisualStyle="{x:Null}">
                                    <Viewbox Width="18" Height="18">
                                        <ui:SymbolIcon Symbol="Delete"/>
                                    </Viewbox>
                                </Button>

                                <ui:ToggleSwitch Grid.Column="3"
                                                 IsOn="{Binding IsEnabled}" 
                                                 OnContent="{x:Null}" OffContent="{x:Null}" 
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Right"
                                                 Width="52"
                                                 MinWidth="52"
                                                 Margin="0"
                                                 Padding="0"
                                                 FocusVisualStyle="{x:Null}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Add New Time -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ui:NumberBox Value="{Binding NewHour}" 
                                  Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[HourLabel]}"
                                  Minimum="0" Maximum="23"
                                  SpinButtonPlacementMode="Inline"
                                  FocusVisualStyle="{x:Null}"/>
                    
                    <TextBlock Text=":" Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,8,8" FontSize="20" FontWeight="Bold"/>
                    
                    <ui:NumberBox Grid.Column="2" 
                                  Value="{Binding NewMinute}" 
                                  Header="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[MinuteLabel]}"
                                  Minimum="0" Maximum="59"
                                  SpinButtonPlacementMode="Inline"
                                  FocusVisualStyle="{x:Null}"/>

                    <Button Grid.Column="3" 
                               Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[AddButton]}" 
                               Command="{Binding AddTimeCommand}"
                               Style="{StaticResource AccentButtonStyle}"
                               VerticalAlignment="Bottom"
                               Margin="10,0,0,0"
                               FocusVisualStyle="{x:Null}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Settings -->
        <Border Grid.Row="3" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="8"
                Padding="16"
                Margin="0,10,0,0">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Setting" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[StartupLabel]}"
                               Margin="0,0,12,0"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ui:ToggleSwitch Grid.Row="0"
                                 Grid.Column="1"
                                 IsOn="{Binding IsStartupEnabled}" 
                                 HorizontalAlignment="Right"
                                 OnContent="{x:Null}" OffContent="{x:Null}" 
                                 Width="52"
                                 MinWidth="52"
                                 Margin="0"
                                 Padding="0"
                                 FocusVisualStyle="{x:Null}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[LanguageLabel]}"
                           VerticalAlignment="Center"
                           Margin="0,14,0,0"/>
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          MinWidth="120"
                          Margin="0,10,0,0"
                          ItemsSource="{Binding AvailableLanguages}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          FocusVisualStyle="{x:Null}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
