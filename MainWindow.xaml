<ui:FluentWindow x:Class="LightsOut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LightsOut"
        xmlns:vm="clr-namespace:LightsOut.ViewModels"
        xmlns:models="clr-namespace:LightsOut.Models"
        xmlns:helpers="clr-namespace:LightsOut.Helpers"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[AppTitle]}"
        Height="650" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[AppTitle]}">
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Master Switch & Countdown -->
            <ui:Card Grid.Row="0" Padding="16,16" Margin="0,0,0,16">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[MainToggleLabel]}" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding CountdownText}"
                                   FontSize="14"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding IsActive}" 
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Margin="0"
                                     Padding="0"
                                     FocusVisualStyle="{x:Null}"/>
                </Grid>
            </ui:Card>

            <!-- Multi-Time List -->
            <Grid Grid.Row="1">
                <ListBox x:Name="TimeListBox"
                         ItemsSource="{Binding ShutdownTimes}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         HorizontalContentAlignment="Stretch"
                         Loaded="OnTimeListLoaded"
                         PreviewMouseLeftButtonDown="OnTimeListPreviewMouseLeftButtonDown"
                         PreviewMouseMove="OnTimeListPreviewMouseMove"
                         PreviewMouseLeftButtonUp="OnTimeListPreviewMouseLeftButtonUp"
                         LostMouseCapture="OnTimeListLostMouseCapture"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.PanningMode="VerticalOnly"
                         ScrollViewer.PanningDeceleration="0.001">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ShutdownTime}">
                            <ui:Card Padding="0">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 覆盖整个卡片的透明按钮 -->
                                    <Button Grid.Column="0" Grid.ColumnSpan="2"
                                            Background="Transparent" 
                                            BorderThickness="0" 
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Cursor="Hand"
                                            Click="TimeItem_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- 时间与重复周期信息 -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="16,14,0,14" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding DisplayTime}" 
                                                   FontSize="32" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding RepeatText, Mode=OneWay}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="13"/>
                                    </StackPanel>

                                    <ui:ToggleSwitch Grid.Column="1"
                                                     IsChecked="{Binding IsEnabled}" 
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Right"
                                                     Margin="0,0,16,0"
                                                     Padding="0"
                                                     FocusVisualStyle="{x:Null}"/>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Add New Time Button (FAB) -->
                <ui:Button Icon="{ui:SymbolIcon Symbol=Add24}" 
                           Appearance="Primary"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,8,8"
                           Width="56" Height="56"
                           CornerRadius="28"
                           Click="BtnAdd_Click">
                    <ui:Button.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.3" ShadowDepth="3" Direction="270" Color="Black"/>
                    </ui:Button.Effect>
                </ui:Button>
            </Grid>

            <!-- Footer / Settings -->
            <ui:Card Grid.Row="2" 
                     Padding="0"
                     Margin="0,16,0,0">
                <StackPanel>
                    <!-- Startup -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Rocket24" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[StartupLabel]}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding IsStartupEnabled}" 
                                         HorizontalAlignment="Right"
                                         Margin="0" Padding="0"
                                         FocusVisualStyle="{x:Null}"/>
                    </Grid>
                    
                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- Language -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="LocalLanguage24" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[LanguageLabel]}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  MinWidth="120"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FocusVisualStyle="{x:Null}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- Theme -->
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Color24" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[ThemeLabel]}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  MinWidth="120"
                                  ItemsSource="{Binding AvailableThemes}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FocusVisualStyle="{x:Null}"/>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
