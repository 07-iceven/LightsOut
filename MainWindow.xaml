<ui:FluentWindow x:Class="LightsOut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LightsOut"
        xmlns:vm="clr-namespace:LightsOut.ViewModels"
        xmlns:models="clr-namespace:LightsOut.Models"
        xmlns:helpers="clr-namespace:LightsOut.Helpers"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[AppTitle]}"
        Height="650" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[AppTitle]}">
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,8,0,16">
                <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[AppTitle]}" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- Master Switch & Countdown -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <ui:Card Padding="16" Margin="0,0,0,10">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[MainToggleLabel]}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,12,0"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding IsActive}" 
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="0"
                                         Padding="0"
                                         FocusVisualStyle="{x:Null}"/>
                    </Grid>
                </ui:Card>

                <ui:Card Padding="20">
                    <TextBlock Text="{Binding CountdownText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </ui:Card>
            </StackPanel>

            <!-- Multi-Time List -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" 
                         ItemsSource="{Binding ShutdownTimes}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ShutdownTime}">
                            <ui:Card Padding="16,12" Margin="0,4">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding DisplayTime}" 
                                               FontSize="22" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Margin="0,0,0,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <ui:Button Grid.Column="2"
                                               Appearance="Transparent"
                                               VerticalAlignment="Center"
                                               Padding="8"
                                               Margin="0,0,10,0"
                                               Command="{Binding DataContext.RemoveTimeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Symbol=Delete24}"/>

                                    <ui:ToggleSwitch Grid.Column="3"
                                                     IsChecked="{Binding IsEnabled}" 
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Right"
                                                     Margin="0"
                                                     Padding="0"
                                                     FocusVisualStyle="{x:Null}"/>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Add New Time -->
                <ui:Card Grid.Row="1" 
                        Padding="12"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[HourLabel]}" 
                                       Margin="0,0,0,4" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"/>
                            <ui:NumberBox Value="{Binding NewHour}" 
                                          Minimum="0" Maximum="23"
                                          SpinButtonPlacementMode="Inline"
                                          FocusVisualStyle="{x:Null}"/>
                        </StackPanel>
                        
                        <TextBlock Text=":" Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,8,8" FontSize="20" FontWeight="Bold"/>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[MinuteLabel]}" 
                                       Margin="0,0,0,4" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"/>
                            <ui:NumberBox Value="{Binding NewMinute}" 
                                          Minimum="0" Maximum="59"
                                          SpinButtonPlacementMode="Inline"
                                          FocusVisualStyle="{x:Null}"/>
                        </StackPanel>

                        <ui:Button Grid.Column="3" 
                                   Appearance="Primary"
                                   Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[AddButton]}" 
                                   Command="{Binding AddTimeCommand}"
                                   VerticalAlignment="Bottom"
                                   Margin="10,0,0,0"
                                   FocusVisualStyle="{x:Null}"/>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- Footer / Settings -->
            <ui:Card Grid.Row="3" 
                    Padding="16"
                    Margin="0,10,0,0">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[StartupLabel]}"
                                   Margin="0,0,12,0"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Row="0"
                                     Grid.Column="1"
                                     IsChecked="{Binding IsStartupEnabled}" 
                                     HorizontalAlignment="Right"
                                     Margin="0"
                                     Padding="0"
                                     FocusVisualStyle="{x:Null}"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[LanguageLabel]}"
                               VerticalAlignment="Center"
                               Margin="0,14,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              MinWidth="120"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding AvailableLanguages}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FocusVisualStyle="{x:Null}"/>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>